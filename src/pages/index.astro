---
import Layout from "../layouts/Layout.astro";
import Link from "../components/Link.astro";
import Eyebrow from "../components/Eyebrow.astro";
import HeroImage from "../assets/images/heroimage.png";
import "../styles/home.css";
import { technologies } from "../constants.ts";
import { Image } from "astro:assets";
---

<Layout
  title="Lukáš Netolický | Computer Enthusiast"
  description="High school student who loves coding and tech stuff."
>
  <section class="container hero">
    <div class="hero-image">
      <Image src={HeroImage} alt="Portrait of Lukáš Netolický, web developer" />
    </div>
    <div class="hero-section">
      <h1>Hey! I'm <span class="highlight">Lukáš</span></h1>
      <p class="hero-subtitle">
        Student developer building full-stack web apps
      </p>
      <p class="hero-description">
        I'm a student developer who enjoys building full-stack web applications.
        Lately I've been doing a lot of frontend work, but I'm most interested
        in the backend. I also teach programming to younger kids, since I enjoy
        passing on what I've learned.
      </p>
      <div class="hero-buttons">
        <Link href="/projects/" type="primary">Check Out My Projects</Link>
        <Link href="/contact/" color="secondary">Contact</Link>
      </div>
    </div>
  </section>

  <!-- About Section -->
  <section class="home-section about">
    <div class="container">
      <Eyebrow>about</Eyebrow>
      <h2>About Me</h2>
      <div class="about-content">
        <p>
          Building projects is how I learn how things really work, and that's
          the part I enjoy most. Sometimes I'll write smaller things from
          scratch just to see how they work on the inside. I'm mostly interested
          in web development, performance, and clean code. Most of my projects
          use React on the frontend, and Go or Hono on the backend.
        </p>
        <p>
          Right now most of my time goes into nimap, a tool for documenting
          physical network infrastructure on a map: where each device is and how
          the cables run between them. It uses Go and PostgreSQL on the backend
          and React for the map. It's still early, but it's the project I'm
          learning the most from at the moment.
        </p>
      </div>
    </div>
  </section>

  <!-- Technologies Section -->
  <section class="container home-section">
    <Eyebrow>stack</Eyebrow>
    <h2>Technologies I Work With</h2>
    <p class="home-section-description">
      Here are some of the tools and technologies I use when building projects.
    </p>
    <ul class="tech-list">
      {
        technologies
          .filter((tech) => tech.homePage)
          .map((tech) => (
            <li>
              {tech.url ? (
                <a
                  href={tech.url}
                  class="list-item"
                  target="_blank"
                  rel="noopener noreferrer"
                  aria-label={tech.name}
                >
                  <tech.icon
                    class="tech-icon"
                    class:list={tech.lightModeIcon && "tech-icon-dark"}
                  />
                  {tech.lightModeIcon && (
                    <tech.lightModeIcon class="tech-icon tech-icon-light" />
                  )}
                </a>
              ) : (
                <div class="list-item" aria-label={tech.name}>
                  <tech.icon
                    class="tech-icon"
                    class:list={tech.lightModeIcon && "tech-icon-dark"}
                  />
                  {tech.lightModeIcon && (
                    <tech.lightModeIcon class="tech-icon tech-icon-light" />
                  )}
                </div>
              )}
            </li>
          ))
      }
    </ul>
  </section>
</Layout>
