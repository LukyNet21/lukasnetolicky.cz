---
import Layout from "../../layouts/Layout.astro";
import PostsCard from "../../components/PostCard.astro";
import "../../styles/projects.css";
import { getCollection } from "astro:content";

const posts = await getCollection("blog", ({ data }) => {
  return (
    data.published &&
    (!data.published || new Date(data.published) <= new Date())
  );
});

const sortedPosts = posts.sort((a, b) => {
  return (
    new Date(b.data.published).getTime() - new Date(a.data.published).getTime()
  );
});
---

<Layout
  title="Posts | Lukáš Netolický"
  description="My personal blog where I share interesting projects and problems I tackle."
>
  <div class="container">
    <section class="page-header">
      <h1>My <span class="highlight">Blog</span></h1>
      <p class="subtitle">
        This is where I write about the projects I've built and the problems I
        run into while building them. Hopefully some of it turns out to be
        useful to someone else too.
      </p>
    </section>

    <section>
      {
        sortedPosts.length !== 0 && (
          <div class="projects-container">
            {sortedPosts.map((post) => (
              <PostsCard data={post.data} id={post.id} />
            ))}
          </div>
        )
      }
    </section>
  </div>
</Layout>
