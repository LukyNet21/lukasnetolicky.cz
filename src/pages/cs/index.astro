---
import Layout from "../../layouts/Layout.astro";
import Link from "../../components/Link.astro";
import Eyebrow from "../../components/Eyebrow.astro";
import HeroImage from "../../assets/images/heroimage.png";
import "../../styles/home.css";
import { technologies } from "../../constants.ts";
import { Image } from "astro:assets";
---

<Layout
  title="Lukáš Netolický | IT nadšenec"
  description="Jsem středoškolák, kterého baví programování a informační technologie."
>
  <section class="container hero">
    <div class="hero-image">
      <Image src={HeroImage} alt="Fotografie Lukáše Netolického" />
    </div>
    <div class="hero-section">
      <h1>Ahoj! Jsem <span class="highlight">Lukáš</span></h1>
      <p class="hero-subtitle">
        Student IT, který vytváří full-stack webové aplikace
      </p>
      <p class="hero-description">
        Jsem student IT a baví mě vytvářet full-stack webové aplikace. Poslední
        dobou dělám hodně na frontendu, ale nejvíc mě zajímá backend a to, jak
        věci opravdu fungují. Kromě vlastních projektů učím programovat i mladší
        děti, protože mě baví předávat znalosti a zkušenosti dál.
      </p>
      <div class="hero-buttons">
        <Link href="/cs/projects/" type="primary">Moje projekty</Link>
        <Link href="/cs/contact/" color="secondary">Kontakt</Link>
      </div>
    </div>
  </section>

  <!-- About Section -->
  <section class="home-section about">
    <div class="container">
      <Eyebrow>o mně</Eyebrow>
      <h2>O mně</h2>
      <div class="about-content">
        <p>
          Tvorba projektů mi pomáhá pochopit, jak věci opravdu fungují, a to mě
          na programování baví nejvíc. Občas si zkusím napsat menší projektíky
          od nuly sám, abych viděl, jak fungují uvnitř. Převážně mě zajímá
          webový vývoj, výkon softwaru a psaní čistého kódu. Většina mých
          projektů používá React na frontendu a na backendu obvykle Go nebo
          Hono.
        </p>
        <p>
          Momentálně věnuji nejvíc času projektu nimap. Je to nástroj na
          dokumentaci fyzické síťové infrastruktury na mapě: kde se které
          zařízení nachází a kudy mezi nimi vedou kabely. Na backendu používá Go
          a PostGIS, na mapu React. Zatím je v počátcích, ale momentálně se u
          něj učím nejvíc.
        </p>
      </div>
    </div>
  </section>

  <!-- Technologies Section -->
  <section class="container home-section">
    <Eyebrow>stack</Eyebrow>
    <h2>Technologie, které používám</h2>
    <p class="home-section-description">
      Toto jsou nástroje a technologie, které momentálně používám k vytváření
      svých projektů. Neustále se učím a zkoumám nové, abych zlepšoval své
      dovednosti.
    </p>
    <ul class="tech-list">
      {
        technologies
          .filter((tech) => tech.homePage)
          .map((tech) => (
            <li>
              {tech.url ? (
                <a
                  href={tech.url}
                  class="list-item"
                  target="_blank"
                  rel="noopener noreferrer"
                  aria-label={tech.name}
                >
                  <tech.icon
                    class="tech-icon"
                    class:list={tech.lightModeIcon && "tech-icon-dark"}
                  />
                  {tech.lightModeIcon && (
                    <tech.lightModeIcon class="tech-icon tech-icon-light" />
                  )}
                </a>
              ) : (
                <div class="list-item" aria-label={tech.name}>
                  <tech.icon
                    class="tech-icon"
                    class:list={tech.lightModeIcon && "tech-icon-dark"}
                  />
                  {tech.lightModeIcon && (
                    <tech.lightModeIcon class="tech-icon tech-icon-light" />
                  )}
                </div>
              )}
            </li>
          ))
      }
    </ul>
  </section>
</Layout>
