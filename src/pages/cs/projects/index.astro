---
import Layout from "../../../layouts/Layout.astro";
import ProjectCard from "../../../components/ProjectCard.astro";
import Eyebrow from "../../../components/Eyebrow.astro";
import "../../../styles/projects.css";
import { getCollection } from "astro:content";

const projects = await getCollection("projects", ({ data }) => {
  return (
    data.published &&
    (!data.published || new Date(data.published) <= new Date())
  );
});

const sortedProjects = projects.sort((a, b) => {
  if (a.data.featured && !b.data.featured) return -1;
  if (!a.data.featured && b.data.featured) return 1;

  return (
    new Date(b.data.published).getTime() - new Date(a.data.published).getTime()
  );
});
---

<Layout
  title="Projekty | Lukáš Netolický"
  description="Mrkněte na moje projekty a to, na čem zrovna pracuju."
>
  <div class="container">
    <section class="page-header">
      <Eyebrow>práce</Eyebrow>
      <h1>Moje projekty</h1>
      <p class="subtitle">
        Nějaké projekty, které jsem vytvořil. Ne všechno, co udělám, se sem
        dostane, jen to, co stojí za ukázání.
      </p>
      <p class="subtitle">Popisy projektů jsou zatím pouze v angličtině.</p>
    </section>

    <section class="projects-container">
      {
        sortedProjects.map((project, index) => (
          <ProjectCard
            {...project}
            loading={index === 0 ? "eager" : "lazy"}
            fetchpriority={index === 0 ? "high" : "auto"}
          />
        ))
      }
    </section>
  </div>
</Layout>
