---
import Layout from "../../layouts/Layout.astro";
import Link from "../../components/Link.astro";
import Badge from "../../components/Badge.astro";
import SectionDots from "../../components/SectionDots.astro";
import Eyebrow from "../../components/Eyebrow.astro";
import "../../styles/about.css";

import { technologies, techCategories, certificates } from "../../constants";
---

<Layout
  title="O mně | Lukáš Netolický"
  description="Něco více o mně, mých zájmech, studiu a programování."
>
  <SectionDots />
  <div>
    <section class="page-header">
      <Eyebrow>o mně</Eyebrow>
      <h1>O mně</h1>
      <p class="subtitle">Moje cesta</p>
    </section>

    <section class="about-content">
      <div class="section">
        <h2 id="who-am-i">Kdo jsem?</h2>
        <p>
          Ahoj! Jsem Lukáš, student a vývojář z České republiky a dělám
          full-stack webový vývoj. Weby tvořím v Reactu nebo Astru na frontendu
          a s Go nebo Hono na backendu. Poslední dobou dělám hodně na frontendu,
          ale nejvíc mě zajímá a baví backend. Baví mě řešit reálné problémy a
          tvořit je v něco, co opravdu jde využijí, rád zkouším nové nástroje a
          frameworky, jestli s nimi dokážu vytvářet lepší software.
        </p>
      </div>

      <div class="section">
        <h2 id="how-i-got-started">Jak jsem se k programování dostal</h2>
        <p>
          K programování jsem se dostal kolem roku 2020, když jsem
          experimentoval s malými projekty a úpravami her, zejména tvorbou
          pluginů pro Minecraft. Zpočátku to byla jen zvědavost a zábava, ale
          když jsem si uvědomil, že dokážu vytvářet věci, které skutečně řeší
          problémy, začal mě vývoj opravdu zajímat.
        </p>
        <p>
          Od té doby jsem se více zaměřil na webový vývoj, převážně vytvářím
          full-stack aplikace a učím se technologie, které konkrétní projekt
          vyžaduje. Baví mě postupně řešit problémy a proměňovat nápady ve
          skutečný, funkční software.
        </p>
      </div>

      <div class="section">
        <h2 id="teaching">Učím</h2>
        <p>
          Přes školu již druhým rokem učím programovat mladší děti. Baví mě
          předávat dál to, co umím a pomáhat někomu rozběhnout jeho první
          programy.
        </p>
      </div>
    </section>

    <section class="section skills-section">
      <div class="about-content">
        <h2 id="skills">Moje dovednosti</h2>

        <div>
          <h3>Technologie, které používám</h3>
          <p class="section-description">
            Toto jsou nástroje a technologie, které používám k vytváření svých
            projektů. Neustále se učím a zkoumám nové, abych zlepšoval své
            dovednosti.
          </p>
          {
            techCategories.map((cat) => (
              <div class="tech-group">
                <h4>{cat.title}</h4>

                <ul class="icon-grid" data-category={cat.key}>
                  {technologies
                    .filter((t) => t.category === cat.key)
                    .map((tech) => (
                      <li aria-label={`${tech.name} icon`}>
                        {tech.url ? (
                          <a
                            class="icon-card item"
                            class:list={{ featured: tech.featured }}
                            href={tech.url}
                            target="_blank"
                            rel="noopener noreferrer"
                            aria-label={`Open ${tech.name} website`}
                            title={tech.name}
                          >
                            <tech.icon
                              class="tech-icon"
                              class:list={
                                tech.lightModeIcon && "tech-icon-dark"
                              }
                            />
                            {tech.lightModeIcon && (
                              <tech.lightModeIcon class="tech-icon tech-icon-light" />
                            )}

                            <span>{tech.name}</span>
                          </a>
                        ) : (
                          <div
                            class="icon-card item"
                            class:list={{ featured: tech.featured }}
                            title={tech.name}
                          >
                            <tech.icon
                              class="tech-icon"
                              class:list={
                                tech.lightModeIcon && "tech-icon-dark"
                              }
                            />
                            {tech.lightModeIcon && (
                              <tech.lightModeIcon class="tech-icon tech-icon-light" />
                            )}

                            <span>{tech.name}</span>
                          </div>
                        )}
                      </li>
                    ))}
                </ul>
              </div>
            ))
          }
        </div>

        <div>
          <h3>Jazyky, kterými mluvím</h3>

          <ul class="language-list">
            <li class="language-item item">
              Čeština
              <span class="language-level">(Rodilý mluvčí)</span>
            </li>

            <li class="language-item item">Angličtina</li>
          </ul>
        </div>
      </div>
    </section>

    <section class="section about-content">
      <h2 id="education">Vzdělání</h2>

      <div class="education-item">
        <a
          href="https://www.delta-skola.cz/"
          target="_blank"
          rel="noopener noreferrer"
        >
          <h3>DELTA - Střední škola informatiky a ekonomie</h3>
        </a>
        <p class="education-date">2024 - Dnes</p>
        <p class="education-desc">
          Momentálně studuji na Deltě, střední škole zaměřené na programování,
          vývoj softwaru a moderní technologie, kde jsem zapojen do <a
            href="https://www.delta-skola.cz/talentovy-program-delta-topgun"
            target="_blank"
            rel="noopener noreferrer">programu TopGun</a
          >, určeného pro studenty s existující IT dovednostmi, kde probíráme
          témata informatiky na úrovni vysoké školy a praktické workshopy.
        </p>
      </div>
    </section>

    <section class="section badges-section">
      <div class="about-content">
        <div class="certifications">
          <h2 id="certifications">Certifikace</h2>
        </div>
        <div class="badges">
          {
            certificates.map((cert) => (
              <Badge image={cert.image} href={cert.href} alt={cert.alt} />
            ))
          }
        </div>
      </div>
    </section>

    <section class="about-content section">
      <h2 id="whats-next">Co dál?</h2>
      <p>
        Teď bych chtěl stavět větší projekty a zlepšit se na backendu, ne se
        držet jen frontendu. Nejvíc mě baví, když se povede udělat něco
        rychlého, co zároveň řeší nějaký skutečný problém.
      </p>

      <div class="cta-container">
        <Link href="/cs/projects/" type="primary">Mrkni na moje projekty</Link>
      </div>
    </section>
  </div>
</Layout>
